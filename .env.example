# Server-side only. Configure separately in Netlify.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Optional; deterministic generation will not require an LLM.
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=
APP_URL=http://localhost:3000
# Existing Codex binding (alternative to QLOO_API_KEY; server only):
api_key=
# Enable Node's inherited proxy support in Codex Cloud:
NODE_USE_ENV_PROXY=1
